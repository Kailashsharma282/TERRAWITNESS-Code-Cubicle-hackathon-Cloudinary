# TerraWitness Environment Configuration

# Database (Default: local SQLite database for zero-config hackathon execution; can point to PostgreSQL if desired)
DATABASE_URL="file:./dev.db"

# Cloudinary Media Infrastructure
# Obtain these from your Cloudinary Console (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_NOTIFICATION_URL="http://localhost:3000/api/webhooks/cloudinary"

# Public Cloudinary configs (for direct client upload widget/signed requests)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI / Vision Configuration (Interfaces: VisionProvider, EmbeddingProvider, NarrationProvider)
# When external keys are absent, deterministic and Cloudinary-standard heuristics are used.
VISION_PROVIDER="CLOUDINARY"
EMBEDDING_PROVIDER="FULLTEXT_FALLBACK"

# Demo Mode & Synthetic Seed Controls
ENABLE_DEMO_SEED="true"
