# ==============================================================================
# TERRAWITNESS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to .env.production or set these in your cloud provider's
# secret management dashboard (e.g., Vercel, AWS ECS, GCP Secret Manager, Docker Compose).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# In production, use managed PostgreSQL (Supabase, Neon, AWS RDS, GCP Cloud SQL, or Docker Postgres).
# For SQLite local fallback, use: "file:./dev.db"
DATABASE_URL="postgresql://terrawitness:terrawitness_secure_password@localhost:5432/terrawitness_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. CLOUDINARY MEDIA INFRASTRUCTURE & TRANSFORMATION LAYER
# ------------------------------------------------------------------------------
# Obtain these from your Cloudinary Console (https://cloudinary.com/console)
# Dashboard -> Product Environment Settings -> Access Keys
CLOUDINARY_CLOUD_NAME="your_production_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_production_api_secret_keep_secret"

# Optional signed/unsigned upload preset configured in Cloudinary Settings -> Upload
CLOUDINARY_UPLOAD_PRESET="terrawitness_production_preset"

# Cloudinary Webhook Notification URL: configure in Cloudinary Console -> Settings -> Webhooks
# Cloudinary sends signed POST requests with X-Cld-Signature headers for delivery confirmation.
CLOUDINARY_NOTIFICATION_URL="https://yourdomain.com/api/webhooks/cloudinary"

# Public Cloudinary parameters (accessible to browser runtime for client direct signed uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_production_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="terrawitness_production_preset"

# ------------------------------------------------------------------------------
# 3. APPLICATION & HOST CONFIGURATION
# ------------------------------------------------------------------------------
# The fully-qualified public canonical URL of your deployed application
# Used for generating verified Evidence Passports, QR codes, and provenance audit links.
NEXT_PUBLIC_APP_URL="https://terrawitness.yourdomain.com"
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 4. AI & VISION PROVIDERS
# ------------------------------------------------------------------------------
# VISION_PROVIDER: "CLOUDINARY" (default) or "MOCK"
# Cloudinary AI automatically extracts tags, auto-captions, dominant colors, and image metadata.
VISION_PROVIDER="CLOUDINARY"

# EMBEDDING_PROVIDER: "FULLTEXT_FALLBACK" (deterministic weighted forensic search)
EMBEDDING_PROVIDER="FULLTEXT_FALLBACK"

# ------------------------------------------------------------------------------
# 5. DATA SEED & INITIALIZATION CONTROLS
# ------------------------------------------------------------------------------
# Set to "false" in strict enterprise production to prevent automatic seeding of demo projects.
# Set to "true" for initial staging, demo environments, or hackathon review.
ENABLE_DEMO_SEED="false"
APPLY_MIGRATIONS="true"
